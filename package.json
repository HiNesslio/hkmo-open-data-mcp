{
  "name": "hkmo-open-data-mcp",
  "version": "0.5.1",
  "description": "Find and read verified Hong Kong and Macao government open data, APIs and map geometry with a local MCP server.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "hkmo-open-data-mcp": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/geo-transform.py','dist/src/geo-transform.py')\"",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --test dist/test/*.test.js",
    "check": "npm run build && npm test",
    "e2e": "npm run build && RUN_E2E=1 node --test dist/test/e2e.test.js",
    "prepack": "npm run build",
    "pack:mcpb": "npm run build && python3 scripts/build_mcpb.py"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.1.11",
    "fast-xml-parser": "^5.11.2",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  },
  "mcpName": "io.github.hinesslio/hkmo-open-data-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiNesslio/hkmo-open-data-mcp.git"
  },
  "homepage": "https://github.com/HiNesslio/hkmo-open-data-mcp#readme",
  "bugs": {
    "url": "https://github.com/HiNesslio/hkmo-open-data-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hong-kong",
    "macao",
    "macau",
    "government-open-data",
    "csdi",
    "geojson"
  ],
  "files": [
    "dist/",
    "skill/SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
